# Copy to deploy/vm/.env on the server and fill in. This file (.env) is git-ignored.

# Your VM's public IP with dots replaced by dashes, + .sslip.io — resolves to your IP and
# gets a real HTTPS cert automatically, no domain registration needed. Example for 152.67.1.9:
SITE_ADDRESS=152-67-1-9.sslip.io

# Required. Generate with:  openssl rand -base64 48
JWT_SECRET=

# Optional. DB password (internal network only; the default is fine for a demo).
DB_PASSWORD=impactbudget

# Scoring: 'none' (free enrichment only) is fine for a public demo. Set 'ollama' only if you
# also run Ollama on the VM, or 'claude' with ANTHROPIC_API_KEY.
SCORING_PROVIDER=none
ANTHROPIC_API_KEY=

# Seed the demo account so the public link is populated on first boot.
DEMO_SEED_ENABLED=true

# Optional Plaid (sandbox). PLAID_WEBHOOK_URL=https://<SITE_ADDRESS>/webhooks/plaid enables
# hands-off auto-sync once you're live on HTTPS.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_WEBHOOK_URL=
