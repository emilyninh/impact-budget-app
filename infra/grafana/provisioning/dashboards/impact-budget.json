{
  "uid": "impact-budget",
  "title": "Impact Budget",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "Merchant cache hit rate",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } },
      "targets": [
        {
          "expr": "sum(rate(categorization_cache_total{result=\"hit\"}[5m])) / clamp_min(sum(rate(categorization_cache_total[5m])), 0.001)",
          "legendFormat": "hit rate"
        }
      ]
    },
    {
      "id": 2,
      "title": "Scoring source (per 5m)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 16, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "sum by (source) (rate(categorization_scoring_total[5m]))",
          "legendFormat": "{{source}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "LLM scoring latency (p95)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(categorization_scoring_latency_seconds_bucket[5m])) by (le, provider))",
          "legendFormat": "{{provider}} p95"
        }
      ]
    },
    {
      "id": 4,
      "title": "HTTP request rate by status",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "expr": "sum by (status) (rate(http_server_requests_seconds_count[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Kafka consumer lag (records)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 13 },
      "targets": [
        {
          "expr": "sum by (client_id) (kafka_consumer_fetch_manager_records_lag)",
          "legendFormat": "{{client_id}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "JVM heap used",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 13 },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})",
          "legendFormat": "heap used"
        }
      ]
    }
  ]
}
