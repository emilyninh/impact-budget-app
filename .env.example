# Copy to `.env` and fill in. `.env` is git-ignored — never commit real keys.

# --- Categorization scoring provider ---
# ollama = local & free (default, no key) | claude = Anthropic API | none = neutral heuristic
SCORING_PROVIDER=ollama
# Local Ollama (run: `ollama run llama3.1`). host.docker.internal reaches the host from the container.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1
# Open Food Facts eco-score enrichment (free, no key)
OPENFOODFACTS_ENABLED=true

# --- Anthropic (only needed if SCORING_PROVIDER=claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- Plaid (transaction ingestion) ---
# Get sandbox keys from https://dashboard.plaid.com (free).
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Public URL Plaid can POST webhooks to. In dev, an ngrok tunnel:
#   ngrok http 8080  ->  https://<id>.ngrok-free.app/webhooks/plaid
PLAID_WEBHOOK_URL=
# OAuth return URL for banks like Chase/Capital One (production only). Must match a redirect
# URI registered in the Plaid Dashboard exactly. Local dev: http://localhost:5173/
PLAID_REDIRECT_URI=
